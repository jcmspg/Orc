# Virtual environment
.venv/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging / build output
*.egg-info/
build/
dist/

# Node / desktop app
node_modules/

# Secrets and local config. orc itself keeps credentials outside the repo
# (~/.config/orc/env); these patterns are a safety net for anything else.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.secret
secrets.json
secrets.yaml

# Tool caches and run artifacts
.vite/
*.bundle
*.log

# Editor / OS
.idea/
.vscode/
.DS_Store
